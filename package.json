{
  "publisher": "linghaosu",
  "author": {
    "email": "slh001@live.cn",
    "name": "linghao.su"
  },
  "name": "regex-visualizer",
  "displayName": "Regex Visualizer",
  "version": "0.0.6",
  "packageManager": "pnpm@10.33.0",
  "description": "",
  "license": "MIT",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/linghaoSu/vscode-regex-visualizer"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "vscode": "^1.68.0",
    "node": ">=20"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "dev": "pnpm build --watch",
    "pack": "vsce package --no-dependencies",
    "lint": "eslint .",
    "test": "vitest",
    "build": "tsup src/index.ts --external vscode",
    "check": "pnpm run typecheck && pnpm run lint",
    "changelog": "changelogen --output CHANGELOG.md --no-commit",
    "release": "pnpm run check && bumpp --commit --push --tag --all --execute \"pnpm run changelog\"",
    "publish": "vsce publish --no-dependencies",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.68.0",
    "bumpp": "^11.0.1",
    "changelogen": "^0.6.2",
    "eslint": "^9.17.0",
    "esno": "^0.16.3",
    "happy-dom": "^8.9.0",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.3",
    "rimraf": "^3.0.2",
    "snapsvg": "^0.5.1",
    "svg-path-bbox": "^1.2.4",
    "tsup": "^6.1.0",
    "typescript": "^4.7.3",
    "vite": "^2.9.11",
    "vitest": "^0.14.1",
    "vsce": "^2.9.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "happy-dom@8.9.0": "patches/happy-dom@8.9.0.patch"
    }
  }
}
